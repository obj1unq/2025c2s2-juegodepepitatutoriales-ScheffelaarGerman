import wollok.game.*
import pepita.*

program pepitaGame {
    game.title("Pepita")
    game.height(10)
    game.width(10)
    game.cellSize(50)
    game.boardGround("fondo.jpg")
    
    game.addVisual(silvestre)
    game.addVisual(pepita)
    
    game.addVisual(muro1)
    game.addVisual(muro2)
    game.addVisual(muro3)
    game.addVisual(muro4)
    
    game.onTick(800, "efectoGravedad", { pepita.caerPorGravedad() })
    
    keyboard.up().onPressDo({ pepita.volar(arriba) silvestre.perseguir(pepita) })
    keyboard.down().onPressDo({ pepita.volar(abajo) silvestre.perseguir(pepita) })
    keyboard.right().onPressDo({ pepita.volar(derecha) silvestre.perseguir(pepita) })
    keyboard.left().onPressDo({ pepita.volar(izquierda) silvestre.perseguir(pepita) })
    
    game.start()
}